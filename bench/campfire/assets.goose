namespace campfire;

const STYLE = "body{font:16px system-ui,sans-serif;max-width:900px;margin:2rem auto;padding:0 1rem;background:#f6f5f1;color:#202b2a}nav{display:flex;gap:1rem;margin-bottom:2rem}a{color:#176e5d}.message{background:white;padding:1rem;margin:.5rem 0;border-radius:.5rem}.message__body{margin-top:.5rem}.message__avatar{float:left;margin:0 1rem .5rem 0}.message__avatar img{border-radius:50%}.message__heading{font-size:.85rem}.message__day-separator{font-size:.75rem;color:#68736e}.message__body p{white-space:pre-wrap}pre{overflow:auto}table{border-collapse:collapse}td,th{border:1px solid #aaa;padding:.4rem}textarea{width:100%;box-sizing:border-box;padding:1rem}button{padding:.7rem 1.3rem;margin:.5rem 0;cursor:pointer}label{display:block;margin:1rem 0}input{padding:.5rem}form{margin-top:1rem}#status{color:#a22}";

const CHAT_SCRIPT = "const list=document.querySelector('[id^=messages_rooms_]');const form=document.querySelector('#composer');const status=document.querySelector('#status');const endpoint=location.pathname+'/messages';let sending=false;async function refresh(){if(sending)return;try{const r=await fetch(endpoint);if(!r.ok||r.redirected)return;const doc=new DOMParser().parseFromString(await r.text(),'text/html');list.replaceChildren(...doc.body.childNodes);}catch{}}form.addEventListener('submit',async e=>{e.preventDefault();if(sending)return;sending=true;status.textContent='';try{const data=new URLSearchParams(new FormData(form));data.set('message[client_message_id]',crypto.randomUUID());const r=await fetch(endpoint,{method:'POST',headers:{'Accept':'text/vnd.turbo-stream.html'},body:data});if(!r.ok||r.redirected||!(r.headers.get('Content-Type')||'').startsWith('text/vnd.turbo-stream.html'))throw new Error('Message not sent; check your session ('+r.status+')');form.reset();}catch(error){status.textContent=error.message;}finally{sending=false;await refresh();}});setInterval(refresh,2000);";
